{
  "id": "layout-ui",
  "name": "Layout compartido — Header, footer, navegación",
  "type": "shared-ui",
  "description": "Shell común inyectado por JavaScript en todas las páginas públicas.",
  "paths": {
    "scripts": ["js/ui/layout.js", "js/core/paths.js"],
    "assets": ["assets/images/logo.png"]
  },
  "dependsOn": ["estilos"],
  "responsabilidades": [
    "Header con navegación y menú hamburguesa",
    "Footer con enlaces institucionales",
