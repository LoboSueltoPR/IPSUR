    "Detección de página activa en el nav"
  ],
  "paginasQueLoUsan": [
    "index.html",
    "pages/institucionales/quienes-somos.html",
    "pages/cms/publicaciones.html",
    "pages/institucionales/convocatorias.html",
    "pages/institucionales/observatorio.html",
    "pages/institucionales/formacion.html",
    "pages/institucionales/agenda.html"
  ],
  "excluidas": ["admin/index.html"]
}
